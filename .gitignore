# Dependencies
node_modules/
**/node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Build output
dist/
build/
.angular/
bin/
obj/
*.dll
*.pdb

# CDK
cdk.out/
