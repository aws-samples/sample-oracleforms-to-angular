# Secrets / local env — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Non-redistributable binaries (bring-your-own from Oracle)
*.jar
*.fmx

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Office docs / local runbooks
*.docx
*.pptx

# Local pipeline test-run reports (regenerated; may contain local paths)
pipeline/**/*_RESULTS.txt

# NOTE: pipeline/**/generated output IS committed on purpose as example artifacts,
# so readers can inspect the AI-generated code without running the Bedrock stages.
