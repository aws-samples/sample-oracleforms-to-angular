# Copy to .env and fill in your own values. NEVER commit a real .env.
# (.env is git-ignored.)

# ---- AWS account / region ----
CDK_DEFAULT_ACCOUNT=<YOUR_AWS_ACCOUNT_ID>
CDK_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# ---- Amazon Bedrock Knowledge Base (Stage 2) ----
# Populated after you provision the KB (pipeline/stage2_kb/provision_kb.py prints these).
KB_ID=<YOUR_KB_ID>
KB_BUCKET=<YOUR_KB_SOURCE_BUCKET>
KB_VPC_ENDPOINT_ID=<YOUR_AOSS_VPC_ENDPOINT_ID>   # OpenSearch Serverless VPC endpoint (collection is VPC-only, not public)

# ---- Modernized "after" runtime ----
CF_DOMAIN=<YOUR_CLOUDFRONT_DOMAIN>            # e.g. dxxxxxxxxxxxxx.cloudfront.net
FRONTEND_BUCKET=<YOUR_FRONTEND_BUCKET>        # S3 bucket serving the Angular SPA
CF_DISTRIBUTION_ID=<YOUR_CLOUDFRONT_DISTRIBUTION_ID>   # for cache invalidation on ship

# ---- Oracle database (bring-your-own; used by the .NET API and shadow tests) ----
ORACLE_HOST=<YOUR_ORACLE_HOST>                # hostname or private IP
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_USER=app_user
ORACLE_PASSWORD=<SET_ME>                      # prefer AWS Secrets Manager in real deployments

# ---- Legacy environment access (only for the optional live-shadow demo) ----
ORACLE_INSTANCE_ID=<YOUR_ORACLE_INSTANCE_ID>  # EC2 instance id, if driving a legacy box over SSM
APEX_ADMIN_PASSWORD=<SET_ME>                  # only if running the browser-driven shadow test
